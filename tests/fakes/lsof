#!/bin/sh
# Fake lsof: prints $FAKE_LSOF_OUT; with FAKE_LSOF_HANG=1 leaves a child behind (pid in $FAKE_LSOF_CHILD_FILE) and hangs.
[ -n "${FAKE_CALL_LOG:-}" ] && echo "lsof $* LC_ALL=${LC_ALL:-}" >> "$FAKE_CALL_LOG"
if [ -n "${FAKE_LSOF_HANG:-}" ]; then
    sleep 30 &
    echo $! > "$FAKE_LSOF_CHILD_FILE"
    sleep 30
fi
printf '%s\n' "${FAKE_LSOF_OUT:-}"
exit "${FAKE_LSOF_RC:-0}"
