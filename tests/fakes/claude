#!/bin/sh
# Fake claude for tests: only --version is supported.
if [ "${1:-}" = "--version" ]; then
    if [ -n "${FAKE_CLAUDE_BAD_BYTES:-}" ]; then
        printf '\377\376 (Claude Code)\n'
        exit 0
    fi
    echo "${FAKE_CLAUDE_VERSION:-2.1.301} (Claude Code)"
    exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
    [ -n "${FAKE_CALL_LOG:-}" ] && echo "claude $*" >> "$FAKE_CALL_LOG"
    [ -n "${FAKE_CALL_LOG:-}" ] && echo "slot=${CLAUDE_SECURESTORAGE_CONFIG_DIR-<unset>}" >> "$FAKE_CALL_LOG"
    if [ -n "${FAKE_CLAUDE_AUTH_CHILD_FILE:-}" ]; then
        sleep 30 &
        echo $! > "$FAKE_CLAUDE_AUTH_CHILD_FILE"
    fi
    sleep "${FAKE_CLAUDE_AUTH_SLEEP:-0}"
    if [ -n "${FAKE_CLAUDE_AUTH_JSON:-}" ]; then
        printf '%s\n' "$FAKE_CLAUDE_AUTH_JSON"
    else
        echo '{"loggedIn": true, "email": "other@example.com", "orgId": "o"}'
    fi
    exit "${FAKE_CLAUDE_AUTH_RC:-0}"
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "login" ]; then
    [ -n "${FAKE_CALL_LOG:-}" ] && echo "claude $*" >> "$FAKE_CALL_LOG"
    [ -n "${FAKE_CALL_LOG:-}" ] && echo "slot=${CLAUDE_SECURESTORAGE_CONFIG_DIR-<unset>}" >> "$FAKE_CALL_LOG"
    exit "${FAKE_CLAUDE_LOGIN_RC:-0}"
fi
if [ -n "${FAKE_CLAUDE_ARGV_LOG:-}" ]; then
    printf '%s\n' "$@" > "$FAKE_CLAUDE_ARGV_LOG"
    echo "slot=${CLAUDE_SECURESTORAGE_CONFIG_DIR-<unset>}" > "$FAKE_CLAUDE_ARGV_LOG.env"
    if [ -n "${FAKE_CLAUDE_WRITE_TRANSCRIPT:-}" ]; then
        mkdir -p "$(dirname "$FAKE_CLAUDE_WRITE_TRANSCRIPT")"
        printf '{"type": "user", "message": {"content": "hi"}, "cwd": "%s"}\n' "$FAKE_CLAUDE_CWD" > "$FAKE_CLAUDE_WRITE_TRANSCRIPT"
    fi
    exit "${FAKE_CLAUDE_RUN_RC:-0}"
fi
echo "fake claude: unsupported arguments: $*" >&2
exit 2
