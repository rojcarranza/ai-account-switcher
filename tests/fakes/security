#!/bin/sh
# Fake keychain tool: refuses the secret-reading flags; else exits $FAKE_SECURITY_RC.
[ -n "${FAKE_CALL_LOG:-}" ] && echo "security $*" >> "$FAKE_CALL_LOG"
for a in "$@"; do
    case "$a" in
        -w*|-g*)
            [ -n "${FAKE_CALL_LOG:-}" ] && echo "FORBIDDEN" >> "$FAKE_CALL_LOG"
            echo "fake security: forbidden flag $a" >&2
            exit 99 ;;
    esac
done
exit "${FAKE_SECURITY_RC:-0}"
